# Copy to .env (gitignored) next to docker-compose.yml
NEO4J_PASSWORD=
# host name the browser uses to reach this machine (graph view connects to Neo4j directly)
PUBLIC_HOST=spiekeroog.fritz.box
APP_PORT=8081
# uid/gid of the owner of ./data (id -u / id -g)
APP_UID=1001
APP_GID=1001
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
